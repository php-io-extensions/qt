{
    "name": "php-io-extensions/qt",
    "type": "php-ext",
    "description": "1:1 PHP bindings of Qt 6 as classes named after their C++ counterparts",
    "keywords": [
        "qt",
        "qt6",
        "linux",
        "gui",
        "event-loop",
        "php-ext"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "info@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        },
        "venusian": {
            "system": {
                "apt": {
                    "build": [
                        "qt6-base-dev",
                        "qt6-multimedia-dev"
                    ],
                    "depends": [
                        "qt6-wayland"
                    ]
                },
                "brew": {
                    "build": [
                        "qt"
                    ]
                }
            }
        }
    },
    "php-ext": {
        "extension-name": "qt",
        "priority": 30,
        "support-zts": true,
        "support-nts": true,
        "os-families": [
            "linux",
            "darwin"
        ],
        "configure-options": [
            {
                "name": "enable-qt",
                "description": "Enable the qt extension",
                "needs-value": false
            }
        ]
    }
}
